<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Deterministic>False</Deterministic>
		<!-- assembly attributes are generated from these properties; the version comes from
		     -p:Version, set from the git tag by the release workflow (local builds: 1.0.0) -->
		<AssemblyTitle>LumosProtobuf</AssemblyTitle>
		<Product>LumosProtobuf</Product>
		<Copyright>Copyright © DMXControl Projects e.V. 2026</Copyright>
	</PropertyGroup>
	<PropertyGroup>
		<!-- NuGet package -->
		<PackageId>DMXControl3-Network-Interface</PackageId>
		<Authors>DMXControl Projects e.V.</Authors>
		<Company>DMXControl Projects e.V.</Company>
		<Description>gRPC client library for the DMXControl 3 network interface</Description>
		<PackageTags>dmxcontrol;dmx;grpc;protobuf</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/DMXControl/DMXControl3-Network-Interface</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DMXControl/DMXControl3-Network-Interface.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.35.1" />
		<PackageReference Include="Grpc.Core.Api" Version="2.80.0" />
		<PackageReference Include="Grpc.Tools" Version="2.83.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="log4net" Version="3.3.2" />
	</ItemGroup>
	<ItemGroup>
    	<Protobuf Include="..\proto\**\*.proto" Link="%(RecursiveDir)%(Filename)%(Extension)" ProtoRoot="..\proto" />
  	</ItemGroup>
</Project>
